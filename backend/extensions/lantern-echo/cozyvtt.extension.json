{
  "packageFormat": "cozyvtt-extension-package/1",
  "manifest": {
    "manifestVersion": "1.0",
    "id": "cozyvtt.sample-lantern",
    "name": "Lantern Echo",
    "version": "1.1.1",
    "description": "A published echo capability, semantic theme, and existing-map overlay example.",
    "compatibility": {
      "extensionApi": "^1.0.0",
      "cozyVtt": "^1.1.0"
    },
    "capabilities": ["commands", "capability-publications", "themes", "renderers"],
    "permissions": ["campaign.read"],
    "commands": [
      {
        "id": "lantern.echo",
        "version": "1.1.0",
        "title": "Echo through the lantern",
        "description": "Returns a short message from the isolated sample extension.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "required": ["message"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "echo": { "type": "string" },
            "source": { "type": "string" }
          },
          "required": ["echo", "source"],
          "additionalProperties": false
        },
        "requiredPermissions": ["campaign.read"],
        "idempotent": true
      }
    ],
    "publishedCapabilities": [
      {
        "id": "lantern_echo",
        "title": "Lantern echo",
        "description": "Echo a message through CozyVTT's sample extension.",
        "commandId": "lantern.echo",
        "requiredPermissions": ["campaign.read"],
        "risk": "read",
        "approval": "never"
      }
    ]
  },
  "entrypoint": "runner.js",
  "checksum": "sha256:95c12fe7e7190d379d6cccd8d2898ae782be649aa062cf8c1f9ec98b9c6e9261",
  "dependencies": {},
  "contributions": {
    "themes": [
      {
        "id": "lantern-night",
        "name": "Lantern Night",
        "contractVersion": "1.0",
        "tokens": {
          "--color-brand": "207 149 75",
          "--color-brand-dark": "118 76 36",
          "--color-accent": "108 143 113",
          "--color-accent-hover": "130 165 135",
          "--color-accent-text": "17 24 20",
          "--color-bg-base": "20 28 30",
          "--color-bg-surface": "31 42 42",
          "--color-bg-surface-light": "43 56 54",
          "--color-bg-surface-dark": "13 19 21",
          "--color-ink": "238 229 207",
          "--color-ink-secondary": "195 188 169",
          "--color-ink-muted": "143 141 128",
          "--color-paper": "246 237 213",
          "--color-danger": "202 92 84",
          "--color-spirit": "126 106 177"
        }
      }
    ],
    "renderers": [
      {
        "id": "lantern-glow",
        "name": "Lantern Glow Overlay",
        "contractVersion": "1.0.0",
        "browserEntrypoint": "renderer.mjs"
      }
    ]
  }
}
